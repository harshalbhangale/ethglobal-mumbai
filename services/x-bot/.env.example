# The @AfterMarkets bot account's X app credentials (OAuth 1.0a, read + write).
# developer.x.com → your app → Keys and tokens. Generate the access token while logged in as the bot account.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Where copy links send people to review and sign.
APP_URL=http://localhost:3000

# 1 to actually post replies. Anything else is a dry run that only logs them.
X_BOT_POST=0
X_POLL_SECONDS=90
