{
  "name": "kallr",
  "version": "0.1.0",
  "private": true,
  "description": "Kallr: tag @Kallr under any crypto call on X to see its after market, copy it with one reply, and get a call back when your exits hit.",
  "workspaces": [
    "kallr-webapp",
    "kallr-extension",
    "kallr-xbot",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @kallr/web",
    "build": "npm run build -w @kallr/web",
    "start": "npm run start -w @kallr/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "x-bot": "npm start -w @kallr/x-bot",
    "brand": "node scripts/make-brand.mjs"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
