{
  "name": "aftermarkets",
  "version": "0.1.0",
  "private": true,
  "description": "AfterMarkets: tag @AfterMarkets under any crypto call on X to see its after market, copy it with one reply, and get a call back when your exits hit.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @aftermarkets/web",
    "build": "npm run build -w @aftermarkets/web",
    "start": "npm run start -w @aftermarkets/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
