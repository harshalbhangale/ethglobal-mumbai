{
  "name": "kallr",
  "version": "0.1.0",
  "private": true,
  "description": "Kall Markets: every crypto call priced, scored and kept on Arkiv, then traded in one tap on Definitive Flash.",
  "workspaces": [
    "kallr-webapp",
    "kallr-extension",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @kallr/web",
    "build": "npm run build -w @kallr/web",
    "start": "npm run start -w @kallr/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "brand": "node scripts/make-brand.mjs"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
