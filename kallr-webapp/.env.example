# Privy app ID from dashboard.privy.io. Enable "Twitter" and "Email" login methods
# and turn on embedded wallets for Ethereum.
NEXT_PUBLIC_PRIVY_APP_ID=
# Privy app secret (server only): checks sign-ins and signs trades from X with the Kall wallet.
PRIVY_APP_SECRET=
# Trade from X with the Kall wallet, no pop-up. In dashboard.privy.io → Wallet infrastructure →
# Authorization keys, create a key: its ID is the signer ID, its private key ("wallet-auth:…") stays
# on the server. Users turn it on in Wallet › Trade from X, which adds this signer to their wallet.
NEXT_PUBLIC_PRIVY_SIGNER_ID=
PRIVY_AUTHORIZATION_KEY=
# Most one trade from X may spend, in USD (default 25).
KALL_X_MAX_USD=25

# Optional: a Base mainnet RPC URL (Alchemy, QuickNode, Ankr). Falls back to the public Base RPC.
NEXT_PUBLIC_BASE_RPC_URL=

# Definitive Flash API key (server only). Falls back to the public development key.
DEFINITIVE_API_KEY=

# Etherscan API V2 key (free at etherscan.io/myapikey, server only). Enables the caller wallet
# check on Base. Token checks (GoPlus, Dexscreener) need no key.
ETHERSCAN_API_KEY=

# Deployed origin (e.g. https://kallmarkets.vercel.app), used for share-card URLs. Defaults to localhost.
NEXT_PUBLIC_SITE_URL=

# Arkiv (testnet Rabdi, chain 7794095): where trade records and calls are stored.
# Server writer key, testnet only. Create one with
#   node --input-type=module -e "import {generatePrivateKey,privateKeyToAccount} from 'viem/accounts'; const k=generatePrivateKey(); console.log(k, privateKeyToAccount(k).address)"
# and fund the address with tGLM at https://hub.arkiv.network/faucet. Without it nothing is written.
ARKIV_PRIVATE_KEY=
# Access keys from https://hub.arkiv.network/access-keys (optional; without them the public RPC is rate limited).
ARKIV_ACCESS_KEY=
# A read key for the browser; lock it to your site in the Arkiv Hub.
NEXT_PUBLIC_ARKIV_ACCESS_KEY=
# Protects /api/arkiv/score (settles expired calls) when set: send "Authorization: Bearer <secret>".
CRON_SECRET=

# Keyboard AI: reading calls and plain-word orders (without it: links and cashtags only).
OPENAI_API_KEY=
# Keyboard voice orders (falls back to OpenAI transcription).
ELEVENLABS_API_KEY=

# Swarm: your own Bee node and postage batch for post snapshots (default: Swarm's public gateway).
SWARM_API_URL=
SWARM_POSTAGE_BATCH_ID=


# iPhone keyboard's demo wallet, held by the server: its key, the token only iPhone builds carry,
# and per-order caps in USD.
KALL_EXEC_PRIVATE_KEY=
KALL_EXEC_TOKEN=
KALL_EXEC_MAX_USD=25
KALL_EXEC_MAX_SWAP_USD=

# "Download our mobile app": direct download links (an item without one shows "coming soon").
NEXT_PUBLIC_ANDROID_APK_URL=
NEXT_PUBLIC_ANDROID_APK_SIZE=
NEXT_PUBLIC_IOS_APP_URL=
# Optional server-only Base RPC for the demo wallet (default: NEXT_PUBLIC_BASE_RPC_URL).
BASE_RPC_URL=
